+    def _update_already_seen(self, update: Update) -> bool:
+        """Exactly-once gate (LOCAL PATCH 2026-08-09).
+
+        Returns True when this PTB ``update_id`` was already handled
+        earlier in this process — i.e. a redelivery after a reconnect,
+        crash recovery, or the 409-conflict handler re-entering polling
+        without dropping pending updates. Without this gate the same
+        update runs the agent turn twice and the user sees the reply
+        twice (observed live in ~/.hermes/state.db). One PTB update
+        dispatches to exactly one handler, so a single shared window
+        across all handlers is correct. Missing update_id (never
+        happens with PTB) fails OPEN: process the message rather than
+        silently dropping user input.
+        """
+        uid = getattr(update, "update_id", None)
+        if uid is None:
+            return False
+        with self._seen_update_lock:
+            if uid in self._seen_update_ids:
+                return True
+            self._seen_update_ids.append(uid)
+            return False
+
